{
  "name": "awaitstep",
  "version": "1.4.14",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "web:dev": "dotenv -- turbo run dev --filter=@awaitstep/web...",
    "test": "dotenv -- turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "dotenv -- pnpm --filter @awaitstep/db db:generate",
    "db:migrate": "dotenv -- pnpm --filter @awaitstep/db db:migrate",
    "db:push": "dotenv -- pnpm --filter @awaitstep/db db:push",
    "nodes:generate": "turbo run build --filter=@awaitstep/node-cli... && node packages/node-cli/dist/cli.js generate",
    "nodes:build": "turbo run build --filter=@awaitstep/node-cli... && node packages/node-cli/dist/cli.js build",
    "prebuild": "pnpm nodes:build",
    "deploy:cf": "pnpm build && pnpm --filter @awaitstep/api deploy:cf && pnpm --filter @awaitstep/web deploy:cf",
    "deploy:cf:api": "pnpm --filter @awaitstep/api deploy:cf",
    "deploy:cf:web": "pnpm --filter @awaitstep/web deploy:cf",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
