{
  "name": "@awaitstep/api",
  "version": "1.4.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/entry/dev.ts",
    "dev:cf": "wrangler dev",
    "deploy:cf": "pnpm d1:migrate && wrangler deploy",
    "d1:create": "wrangler d1 create awaitstep",
    "d1:migrate": "wrangler d1 migrations apply awaitstep --remote",
    "d1:migrate:local": "wrangler d1 migrations apply awaitstep --local",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@awaitstep/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "9.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@awaitstep/codegen": "workspace:*",
    "@awaitstep/db": "workspace:*",
    "@awaitstep/email": "workspace:*",
    "@awaitstep/ir": "workspace:*",
    "@awaitstep/provider-cloudflare": "workspace:*",
    "@awaitstep/storage": "workspace:*",
    "@cloudflare/sandbox": "^0.12.7",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.7.14",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "hono-rate-limiter": "^0.5.4",
    "nanoid": "^6.0.2",
    "pg": "8.23.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  }
}
