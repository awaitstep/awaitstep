---
import '../styles/global.css'
import SiteNav from '../components/site/SiteNav.astro'
import SiteFooter from '../components/site/SiteFooter.astro'
import { inlineJson, pagePath } from '../lib/paths'

interface Props {
  title: string
  description: string
  jsonLd?: Record<string, unknown>[]
  /** The page opens on a full-bleed hero (or a page opening) the nav sits over. */
  overHero?: boolean
  /** The footer's large closing line. */
  closing?: string
  /** The share card in /og/, by name (`pricing` is /og/pricing.png). */
  image?: string
  /** The page's name in the breadcrumb trail search results show; the home page has none. */
  crumb?: string
  /** Keep the page out of search results (the 404 page): no canonical, a noindex robots tag. */
  noindex?: boolean
}

const {
  title,
  description,
  jsonLd = [],
  overHero = true,
  closing,
  image = 'home',
  crumb,
  noindex = false,
} = Astro.props
const path = pagePath(Astro.url.pathname)
const canonical = new URL(path, Astro.site).toString()
// Relative, so each deploy (production, staging, previews) serves its own share image.
const imageUrl = `/og/${image}.png`
const breadcrumbs = crumb
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'AwaitStep', item: new URL('/', Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
        ],
      },
    ]
  : []
const structured = [...breadcrumbs, ...jsonLd]
---

<!doctype html>
<html lang="en" class="landing">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AwaitStep" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Before paint: the `js` class that script-dependent styles key off. If the site script has
      // not started within a few seconds (it failed to load), the page falls back to its no-script
      // layout, so a phone never keeps a hidden menu with no button to open it.
      document.documentElement.classList.add('js')
      setTimeout(function () {
        if (!document.documentElement.hasAttribute('data-site-ready'))
          document.documentElement.classList.remove('js')
      }, 4000)
    </script>
    {structured.map((data) => <script type="application/ld+json" set:html={inlineJson(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteNav overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter statement={closing} />
    <script>
      import { initSite } from '../scripts/site'
      initSite()
    </script>
  </body>
</html>
