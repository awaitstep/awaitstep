---
import Base from '../layouts/Base.astro'
import HeroVideo from '../components/home/HeroVideo.astro'
import Shot from '../components/home/Shot.astro'
import codeShot from '../assets/product/code.png'
import overviewShot from '../assets/product/overview.png'
import buildShot from '../assets/product/step-build.png'
import testShot from '../assets/product/step-test.png'
import shipShot from '../assets/product/step-ship.png'
import watchShot from '../assets/product/step-watch.png'
import { CLOSE, CODE, EDITIONS, FAQ, HERO, KINDS, LOOP, META, SHIP, TEAMS } from '../content/home'
import { APP_URL, INSTALL_URL, REPO_URL } from '../content/site'

const stepShots = [buildShot, testShot, shipShot, watchShot] as const

const { before: lead, accent: key, after: end } = HERO.titleSecond
const summary =
  'A pass through the AwaitStep dashboard: open a project and its workspace, open a workflow, read and edit its code, open a step on the canvas, check what is deployed on each account, and open a run with each of its steps.'

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'AwaitStep', url: 'https://awaitstep.dev', logo: 'https://awaitstep.dev/logo.svg', sameAs: [REPO_URL] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'AwaitStep', url: 'https://awaitstep.dev' },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'AwaitStep',
    url: APP_URL,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description: META.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'AwaitStep in one minute',
    description: 'Open a project and a workflow, read its TypeScript, switch to the canvas, and deploy it live.',
    thumbnailUrl: 'https://awaitstep.dev/video/demo-poster.jpg',
    contentUrl: 'https://awaitstep.dev/video/demo.mp4',
    uploadDate: '2026-11-21',
    duration: 'PT1M1S',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
]
---

<Base title={META.title} description={META.description} jsonLd={jsonLd} overHero closing={CLOSE.statement}>

    <section class="hero" aria-labelledby="hero-title">
      <HeroVideo summary={summary} class="hero__scene" />
      <div class="container hero__text">
        <h1 id="hero-title">{HERO.title}<br />{lead}<span class="hero__accent">{key}</span>{end}</h1>
        <p class="lead">{HERO.line}</p>
        <div class="actions">
          <a class="btn" href={APP_URL}>Start building</a>
          <a class="btn btn--quiet" href="/video/demo.mp4" data-demo-open aria-haspopup="dialog">Watch the demo</a>
        </div>
        <dl class="modes">
          {HERO.modes.map((m) => <div><dt><a href={m.href}>{m.label}</a></dt><dd>{m.value}</dd></div>)}
        </dl>
      </div>
    </section>

    <dialog class="demo" aria-labelledby="demo-title" data-demo>
      <div class="demo__body">
      <div class="demo__head">
        <h2 id="demo-title">AwaitStep in one minute</h2>
        <button class="demo__close" type="button" data-demo-close>Close</button>
      </div>
      <video class="demo__video" src="/video/demo.mp4" poster="/video/demo-poster.jpg" controls playsinline preload="none"></video>
      </div>
    </dialog>

    <section class="section loop" data-steps aria-labelledby="loop-title">
      <div class="loop__track" style={`--beats: ${LOOP.beats.length}`}>
        <div class="container loop__pin">
          <h2 id="loop-title">{LOOP.title}</h2>
          <ol class="loop__beats">
            {LOOP.beats.map((b, i) => (
              <li data-step={i} aria-current={i === 0 ? 'step' : undefined}>
                <span class="loop__bar" aria-hidden="true"><span></span></span>
                <span class="loop__num" aria-hidden="true">{i + 1}</span>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </li>
            ))}
          </ol>
          <p class="loop__now" aria-hidden="true">{LOOP.beats[0].body}</p>
          <div class="loop__stage">
            {LOOP.beats.map((b, i) => (
              <Shot
                class:list={['loop__shot', i === 0 && 'is-active']}
                src={stepShots[i]}
                alt={b.alt}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section kinds" aria-labelledby="kinds-title">
      <div class="container">
        <h2 id="kinds-title">{KINDS.title}</h2>
        <div class="kinds__grid">
          {[KINDS.workflows, KINDS.functions].map((k) => (
            <div class="kinds__col">
              <h3>{k.title}</h3>
              <p>{k.body}</p>
              <ul class="ticks">{k.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          ))}
        </div>
        <div class="facts">
          {KINDS.facts.map((f) => <p><strong>{f.value}</strong> {f.label}</p>)}
          <p class="facts__more">{KINDS.more}</p>
        </div>
      </div>
    </section>

    <section class="section build" aria-labelledby="build-title">
      <div class="container">
        <div class="head">
          <h2 id="build-title">{CODE.title}</h2>
          <p class="lead">{CODE.line}</p>
        </div>
        <Shot
          src={codeShot}
          alt="The AwaitStep Code view: the project's files on the left, the generated workflow.ts in a typed editor, and the same workflow as a canvas preview on the right."
          caption={CODE.caption}
        />
      </div>
    </section>

    <section class="section ship" aria-labelledby="ship-title">
      <div class="container">
        <div class="head">
          <h2 id="ship-title">{SHIP.title}</h2>
        </div>
        <Shot
          src={overviewShot}
          alt="A workflow's overview in AwaitStep: live on two accounts with the version on each, its trigger, its versions and its recent runs."
          caption={SHIP.caption}
        />
        <dl class="rows rows--across">
          {SHIP.points.map((pt) => <div><dt>{pt.title}</dt><dd>{pt.body}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="section teams" aria-labelledby="teams-title">
      <div class="container teams__grid">
        <h2 id="teams-title">{TEAMS.title}</h2>
        <dl class="rows rows--wide">
          {TEAMS.rows.map((r) => <div><dt>{r.title}</dt><dd>{r.body}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="section editions" aria-labelledby="editions-title">
      <div class="container">
        <h2 id="editions-title">{EDITIONS.title}</h2>
        <div class="editions__grid">
          {[
            { ...EDITIONS.cloud, href: APP_URL, primary: true },
            { ...EDITIONS.selfHost, href: INSTALL_URL, primary: false },
          ].map((e) => (
            <div class:list={['edition', e.primary && 'edition--primary']}>
              <h3>{e.name}</h3>
              <p class="edition__line">{e.line}</p>
              <ul class="ticks">{e.points.map((pt) => <li>{pt}</li>)}</ul>
              <a class:list={['btn', !e.primary && 'btn--quiet']} href={e.href}>{e.action}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section faq" aria-labelledby="faq-title">
      <div class="container faq__grid">
        <h2 id="faq-title">Questions</h2>
        <div class="faq__list">
          {FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
</Base>

<script>
  import { initPage } from '../scripts/home'
  initPage()
</script>
