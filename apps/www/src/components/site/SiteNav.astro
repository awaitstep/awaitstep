---
import { APP_URL, NAV_LINKS, REPO_URL } from '../../content/site'
import { starCount } from '../../lib/github'
import { pagePath } from '../../lib/paths'

interface Props {
  /** The nav starts see-through over a full-bleed hero, and turns solid once the hero scrolls away. */
  overHero?: boolean
}

const { overHero = false } = Astro.props
const stars = await starCount()
const here = pagePath(Astro.url.pathname)
const repoLabel = stars ? `AwaitStep on GitHub, ${stars} stars` : 'AwaitStep on GitHub'
---

<header class:list={['nav', !overHero && 'is-solid']} data-nav data-over-hero={overHero ? '' : undefined}>
  <div class="container nav__bar">
    <a class="wordmark" href="/" aria-label="AwaitStep home">
      <svg class="wordmark__mark" viewBox="0 0 80 38" aria-hidden="true">
        <rect width="52" height="10" rx="2" />
        <rect x="14" y="14" width="52" height="10" rx="2" opacity="0.62" />
        <rect x="28" y="28" width="52" height="10" rx="2" opacity="0.32" />
      </svg>
      <span>AwaitStep</span>
    </a>

    {/* Before the menu it opens, so Tab goes from the button straight into the open links. */}
    <button
      class="nav__toggle"
      type="button"
      aria-label="Menu"
      aria-controls="site-menu"
      aria-expanded="false"
      data-nav-toggle
      hidden
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path class="nav__toggle-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="nav__toggle-close" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <nav class="nav__menu" id="site-menu" aria-label="Main" data-nav-menu>
      <ul class="nav__links">
        {
          NAV_LINKS.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === here ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__repo" href={REPO_URL} aria-label={repoLabel}>
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span class="nav__repo-name">GitHub</span>
            {stars && <span class="nav__count" aria-hidden="true">{stars}</span>}
          </a>
        </li>
      </ul>
    </nav>

    <div class="nav__end">
      <a class="btn btn--small btn--quiet" href={APP_URL}>Sign in</a>
    </div>
  </div>
</header>
