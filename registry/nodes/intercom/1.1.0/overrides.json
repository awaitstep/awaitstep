{
  "version": "1.1.0",
  "description": "Manage Intercom contacts and conversations",
  "tags": ["intercom", "customer-support", "messaging", "contacts"],
  "configSchema": {
    "action": {
      "options": [
        "Create Contact",
        "Get Contact",
        "Send Message",
        "List Conversations",
        "Reply to Conversation",
        "List Contacts",
        "Tag Contact",
        "Close Conversation",
        "List Admins"
      ]
    },
    "tagId": {
      "type": "string",
      "label": "Tag ID",
      "description": "Tag ID. Used by: Tag Contact."
    },
    "limit": {
      "type": "number",
      "label": "Limit",
      "default": 20,
      "validation": {
        "min": 1,
        "max": 150
      },
      "description": "Maximum contacts. Used by: List Contacts."
    }
  },
  "outputSchema": {
    "id": {
      "nullable": true
    }
  },
  "docsUrl": "https://developers.intercom.com/docs/build-an-integration/learn-more/rest-apis/",
  "runtime": {
    "defaultRetries": 2
  }
}
