{
  "version": "2.0.0",
  "description": "Manage Trello cards, comments, lists, and boards",
  "tags": ["trello", "project-management", "cards", "boards"],
  "configSchema": {
    "action": {
      "options": [
        "Create Card",
        "Get Card",
        "Update Card",
        "List Cards",
        "Move Card",
        "Delete Card",
        "Add Comment",
        "List Boards"
      ]
    },
    "comment": {
      "type": "textarea",
      "label": "Comment",
      "description": "Comment text. Used by: Add Comment."
    }
  },
  "outputSchema": {
    "id": {
      "nullable": true
    }
  },
  "docsUrl": "https://developer.atlassian.com/cloud/trello/rest/",
  "runtime": {
    "defaultRetries": 2
  }
}
