{
  "version": "1.1.0",
  "description": "Manage Jira issues, comments, transitions, and projects",
  "tags": ["jira", "issues", "project-management", "atlassian"],
  "configSchema": {
    "action": {
      "options": [
        "Create Issue",
        "Get Issue",
        "Add Comment",
        "Transition Issue",
        "Update Issue",
        "Delete Issue",
        "Search Issues",
        "List Projects"
      ]
    },
    "jql": {
      "type": "textarea",
      "label": "JQL",
      "placeholder": "project = ABC AND status = \"To Do\"",
      "description": "Jira Query Language expression. Used by: Search Issues."
    },
    "maxResults": {
      "type": "number",
      "label": "Max Results",
      "default": 50,
      "validation": {
        "min": 1,
        "max": 100
      },
      "description": "Maximum issues to return. Used by: Search Issues."
    }
  },
  "outputSchema": {
    "id": {
      "nullable": true
    }
  },
  "docsUrl": "https://developer.atlassian.com/cloud/jira/platform/rest/v3/intro/",
  "runtime": {
    "defaultRetries": 2
  }
}
