{
  "version": "1.1.0",
  "description": "Manage Stripe payments, customers, subscriptions, and refunds",
  "tags": ["stripe", "payments", "billing", "subscriptions", "customers"],
  "configSchema": {
    "action": {
      "options": [
        "Create Payment Intent",
        "Retrieve Payment Intent",
        "Create Customer",
        "Retrieve Customer",
        "Create Charge",
        "Create Refund",
        "List Customers",
        "Capture Payment Intent",
        "Create Subscription",
        "List Payment Intents"
      ]
    },
    "priceId": {
      "type": "string",
      "label": "Price ID",
      "placeholder": "price_...",
      "description": "Stripe price ID. Used by: Create Subscription."
    },
    "limit": {
      "type": "number",
      "label": "Limit",
      "default": 20,
      "validation": { "min": 1, "max": 100 },
      "description": "Maximum results. Used by: List Customers, List Payment Intents."
    }
  }
}
