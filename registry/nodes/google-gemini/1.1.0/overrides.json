{
  "version": "1.1.0",
  "description": "Generate content, JSON, embeddings, and grounded answers with Gemini 3",
  "tags": ["google", "gemini", "ai", "llm", "embedding", "search"],
  "configSchema": {
    "action": {
      "options": [
        "Generate Content",
        "Generate JSON",
        "Embed Text",
        "Search Web",
        "Count Tokens",
        "Batch Embed",
        "List Models"
      ]
    },
    "model": {
      "type": "select",
      "default": "gemini-3-flash",
      "options": ["gemini-3-flash", "gemini-3-pro", "gemini-2.5-flash", "gemini-2.5-flash-lite"]
    },
    "jsonSchema": {
      "type": "textarea",
      "label": "JSON Schema",
      "description": "JSON Schema for structured output. Used by: Generate JSON."
    }
  }
}
