{
  "name": "@awaitstep/provider-cloudflare",
  "version": "1.4.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/generate.d.ts",
      "import": "./dist/codegen/generate.js"
    }
  },
  "scripts": {
    "build": "node scripts/emit-runtime-source.mjs && tsup",
    "dev": "node scripts/emit-runtime-source.mjs && tsup --watch",
    "test": "vitest run --passWithNoTests",
    "type-check": "node scripts/emit-runtime-source.mjs && tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@awaitstep/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@awaitstep/codegen": "workspace:*",
    "@awaitstep/ir": "workspace:*",
    "@awaitstep/sdk": "workspace:*",
    "wrangler": "4.152.0",
    "zod": "^4.6.7"
  }
}
