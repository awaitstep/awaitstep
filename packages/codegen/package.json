{
  "name": "@awaitstep/codegen",
  "version": "1.4.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transpile": {
      "types": "./dist/transpile.d.ts",
      "import": "./dist/transpile.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@awaitstep/tsconfig": "workspace:*",
    "tsup": "9.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@awaitstep/ir": "workspace:*",
    "@awaitstep/sdk": "workspace:*",
    "sucrase": "^3.35.1"
  }
}
