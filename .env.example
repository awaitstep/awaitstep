# Security
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8080

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare OAuth (optional). Unset in development: the API's own stub answers,
# so Connections can run the flow without a Cloudflare account. Set both to a
# self-managed OAuth client (grant types authorization_code and refresh_token)
# to use the real dash.cloudflare.com consent flow.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Must match the registered redirect URI byte for byte.
# CLOUDFLARE_OAUTH_REDIRECT_URI=https://api.example.com/api/oauth/cloudflare/callback
# Must be scopes the OAuth client is allowed to request (colon-delimited IDs are
# rejected). Workers scopes are role-named: workers-scripts.edit (Editor) or
# workers-scripts.admin (Admin); workers-scripts.write is retired. The default is
# account-settings.read + workers-scripts.edit + workers-kv-storage.read + .write
# (KV lists and writes keys, so both are requested).
# Cloudflare's role model puts creating and deleting Workers under Admin, so
# switch to workers-scripts.admin if the first deploy of a new Worker is refused.
# Other products keep their names: workers-r2.read/.write,
# workers-r2-bucket-item.read/.write, d1.read/.write, queues.read/.write,
# workers-routes.read/.write, workers-observability.read, workers-tail.read,
# secrets-store.write, browser-rendering.read/.write.
# CLOUDFLARE_OAUTH_SCOPES="account-settings.read workers-scripts.edit workers-kv-storage.read workers-kv-storage.write"
# Set to 0 to turn the development stub off.
# CLOUDFLARE_OAUTH_STUB=0

# App
APP_NAME=awaitstep-worker

# Server
PORT=8080
NODE_ENV=development


# PostgreSQL (for self-hosted, leave empty for SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/awaitstep
